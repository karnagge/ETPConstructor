# Database
DATABASE_URL="postgresql://etp_user:etp_password@localhost:5432/etp_generator?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Anthropic API (REQUIRED - Get your key from https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Server
PORT=3001
NODE_ENV=development

# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000

# File storage
UPLOADS_DIR=./uploads
DOCUMENTS_DIR=./uploads/documents
