{
  "name": "etp-constructor",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema web para geração automatizada de Estudos Técnicos Preliminares (ETP) para licitações públicas no Brasil",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "type-check": "turbo run type-check",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:migrate": "pnpm --filter backend prisma migrate dev",
    "db:studio": "pnpm --filter backend prisma studio",
    "db:seed": "pnpm --filter backend prisma db seed"
  },
  "devDependencies": {
    "@turbo/gen": "^1.11.1",
    "prettier": "^3.1.0",
    "turbo": "^1.11.1",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
